# Personal / local-only — never commit
CLAUDE.local.md
.claude/settings.local.json
.env
.env.*

# App runtime
/config/
*.db
*.sqlite

# Python
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node / frontend
node_modules/
web/dist/
web/.vite/

# OS / editor
.DS_Store
.idea/

# Browser/session artifacts (ad hoc screenshots dropped at the repo root — not fixture images,
# which live under tests/fixtures/ or docs/images/ and must stay tracked)
.playwright-mcp/
/*.jpeg

# hypothesis's own example database (test_privacy.py's @given properties) — not fixtures, and one
# `git add -A` away from being committed if left untracked-but-unignored
.hypothesis/

# npm's lockfile. This project is pnpm (`packageManager` in web/package.json, and CI installs with
# `pnpm --frozen-lockfile` against pnpm-lock.yaml). A stray `npm install` writes one of these, and a
# second competing lockfile drifts from the real one and misleads anyone who reads it.
package-lock.json

# Scratch worktrees created by background agents — full repo copies, never committed.
.claude/worktrees/
