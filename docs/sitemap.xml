---
layout: null
sitemap: false
permalink: /sitemap.xml
---
{%- comment -%}
Replaces jekyll-sitemap's template, which only writes <lastmod> from `last_modified_at`; this site's
pages carry `updated:` instead. Otherwise identical: every html page except 404 and `sitemap: false`.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | where_exp: 'p', 'p.sitemap != false' | where_exp: 'p', 'p.url != "/404.html"' %}
{%- for p in pages %}
  <url>
    <loc>{{ p.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
    {%- assign modified = p.last_modified_at | default: p.updated %}
    {%- if modified %}
    <lastmod>{{ modified | date: '%Y-%m-%d' }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
